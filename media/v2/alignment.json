      "start": 42.23,
      "end": 43.63,
      "word_indices": [
        92,
        93,
        94
      ]
    },
    {
      "text": "A grove of trees.",
      "start": 43.65,
      "end": 45.15,
      "word_indices": [
        95,
        96,
        97,
        98
      ]
    },
    {
      "text": "An accessible loop.",
